
from flask import Flask, request, jsonify
from flask_cors import CORS
import joblib
import numpy as np

app = Flask(__name__)
CORS(app)

class CropPredictor:
    def __init__(self):
        self.model = joblib.load('crop_model.pkl')
        self.le = joblib.load('label_encoder.pkl')

    def get_all_probabilities(self, N, P, K, temperature, humidity, ph, rainfall):
        data = np.array([[N, P, K, temperature, humidity, ph, rainfall]])
        probabilities = self.model.predict_proba(data)[0]

        crops = self.le.inverse_transform(range(len(probabilities)))
        return [(crop.title(), prob * 100) for crop, prob in zip(crops, probabilities)]

predictor = CropPredictor()

# ✅ ADD THIS ROUTE
@app.route("/", methods=["GET"])
def home():
    return "Backend running"

# ❗ DO NOT CHANGE THIS
@app.route("/api/predict", methods=["POST"])
def predict():
    data = request.json

    all_predictions = predictor.get_all_probabilities(
        N=data["N"],
        P=data["P"],
        K=data["K"],
        temperature=data["temperature"],
        humidity=data["humidity"],
        ph=data["ph"],
        rainfall=data["rainfall"]
    )

    return jsonify({
        "all_predictions": sorted(all_predictions, key=lambda x: x[1], reverse=True),
        "success": True
    })

if __name__ == "__main__":
    app.run(debug=True, port=5000)
